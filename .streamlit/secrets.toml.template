# LDP Dashboard Secrets Configuration
# Copy this file to secrets.toml and fill in your actual credentials
# NEVER commit secrets.toml to git!

[airtable]
api_key = "your_airtable_api_key_here"
base_id = "your_airtable_base_id_here"

[supabase]
# Get this from Supabase: Project Settings > Database > Connection string (pooling mode)
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
connection_string = "postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"

[auth]
username = "admin"
name = "Admin LDP"
# Generate password hash with: python3 -c "import streamlit_authenticator as stauth; print(stauth.Hasher(['your_password']).generate()[0])"
password_hash = "$2b$12$..."
cookie_name = "ldp_dashboard_auth"
# Generate random 32+ char string for cookie_key
cookie_key = "your_random_secret_key_min_32_characters_here"
